# AGP, src/main/keepRules altındaki tüm dosyaları R8'e verir.

# kotlinx.serialization: @Serializable modellerin serializer'ları ve alan adları (@SerialName) korunur.
-keepattributes *Annotation*, InnerClasses, Signature, Exceptions, RuntimeVisibleAnnotations
-keepclassmembers class com.rapidquiz.app.data.model.** {
    *** Companion;
    kotlinx.serialization.KSerializer serializer(...);
}
-keep,includedescriptorclasses class com.rapidquiz.app.data.model.**$$serializer { *; }
-keepclasseswithmembers class com.rapidquiz.app.data.** {
    kotlinx.serialization.KSerializer serializer(...);
}
-keep class com.rapidquiz.app.data.model.** { *; }

# Retrofit: arayüz metotları ve suspend fonksiyonlardaki Continuation imzası.
-keep interface com.rapidquiz.app.data.api.RapidQuizApi { *; }
-keepattributes RuntimeVisibleParameterAnnotations
-dontwarn javax.annotation.**
-dontwarn org.codehaus.mojo.animal_sniffer.IgnoreJRERequirement
